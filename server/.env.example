# -- Server --------------------------------------------------------------------
PORT=5000

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# -- MongoDB Atlas -------------------------------------------------------------
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/recruit-ai?appName=Cluster0

# -- Qdrant Cloud --------------------------------------------------------------
# Get from: https://cloud.qdrant.io
QDRANT_URL=https://<cluster-id>.aws.cloud.qdrant.io
QDRANT_API_KEY=<your-qdrant-api-key>

# -- Groq ----------------------------------------------------------------------
# Get from: https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>
